# API ID from https://my.telegram.org/apps (required; numeric).
API_ID=

# API hash from https://my.telegram.org/apps (required; keep private).
API_HASH=

# Comma-separated source channel usernames and/or exact numeric IDs (required).
# For private channels, use the full -100... channel ID.
SOURCE_CHANNELS=

# Destination channel username or numeric ID (required); this user must be allowed to post.
ANNOUNCEMENT_CHANNEL=

# Optional public HTTPS base URL for an existing VPS with /open/stremio and /open/nuvio routes.
# Leave blank to use IMDb/TMDb links instead.
PUBLIC_BASE_URL=

# false = one announcement per title; true = one announcement per series episode.
ANNOUNCE_EACH_EPISODE=false

# Local PyroFork user-session file name; never commit the resulting .session file.
SESSION_NAME=telestremio_announcer

# Local SQLite state file; never commit this file.
STATE_DB=announcements.sqlite3

# Log verbosity: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
