# Telegram API credentials from https://my.telegram.org/apps
API_ID=
API_HASH=

# Comma-separated Telegram source channels. Use numeric IDs for private channels.
SOURCE_CHANNELS=@your_source_channel

# Channel where this account can publish posts. Must be an admin with post permission.
ANNOUNCEMENT_CHANNEL=@your_announcement_channel

# Optional public HTTPS redirect base that implements /open/stremio and /open/nuvio.
# Leave empty for IMDb/TMDb information buttons.
PUBLIC_BASE_URL=

# false = one post per movie/series; true = one post per episode.
ANNOUNCE_EACH_EPISODE=false

# Local-only session/database filenames. Do not upload them.
SESSION_NAME=telestremio_announcer
STATE_DB=announcements.sqlite3

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
